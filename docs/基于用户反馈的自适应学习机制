5. LLM 少样本学习
对于 LLM 语义合并模块，用户的修改是最好的 Prompt 示例。我们可以将用户的合并/拆分动作提取为 JSON 格式，动态注入到下次的 Prompt 中：

def build_dynamic_prompt_with_feedback(
    base_prompt: str,
    historical_feedback: List[dict],
    max_examples: int = 3
) -> str:
    """将用户历史修改作为 Few-shot 示例注入 Prompt"""
    
    if not historical_feedback:
        return base_prompt
    
    # 筛选最具代表性的修改案例
    examples = []
    for fb in historical_feedback[:max_examples]:
        if fb["type"] == "should_merge":
            examples.append(
                f'Example (User Preference):\n'
                f'Fragments: {fb["fragments"]}\n'
                f'User Decision: MERGE\n'
                f'Reason: User prefers combining closely spaced clauses.'
            )
        elif fb["type"] == "should_split":
            examples.append(
                f'Example (User Preference):\n'
                f'Fragment: {fb["fragment"]}\n'
                f'User Decision: SPLIT at "{fb["split_word"]}"\n'
                f'Reason: User prefers shorter subtitle lines for readability.'
            )
    
    few_shot_block = "\n\n".join(examples)
    return f"{base_prompt}\n\n--- Historical User Preferences ---\n{few_shot_block}\n--- End Preferences ---"

